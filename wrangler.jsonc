{
  // Cloudflare Worker for not-sal.com/alsobh/: serves the game from ./site/alsobh and runs the rooms
  // (one Durable Object per room code, a WebSocket per phone at /alsobh/ws/<code>)
  "name": "alsobh-alaswad",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./site", "binding": "ASSETS" },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "routes": [{ "pattern": "not-sal.com/alsobh*", "zone_name": "not-sal.com" }],
  "observability": { "enabled": true }
}
